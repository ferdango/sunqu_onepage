# Copia este archivo como .env (setup.sh lo hace solo). Solo para el entorno local.
DB_NAME=sunqu
DB_USER=sunqu
DB_PASSWORD=sunqu-local
DB_ROOT_PASSWORD=sunqu-root-local
WP_PORT=8080
WEB_PORT=8081
WP_URL=http://localhost:8080
WEB_URL=http://localhost:8081
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=sunqu-admin-local
WP_ADMIN_EMAIL=admin@sunqu.test
# Deja vacío para subir las imágenes a la biblioteca; --sin-imagenes importa más rápido (referencias tal cual).
IMPORT_FLAGS=
# Token para que WordPress vacíe la caché de la web al guardar (setup.sh lo genera si falta)
PURGE_TOKEN=
# Opcional, solo para probar la medición en local (no uses IDs reales de producción aquí)
GA4_ID=
GTM_ID=
META_PIXEL_ID=
CONSENT_MODE=banner
