# ─────────────────────────────────────────────────────────────────────────────
# Sunqu Journeys · producción en Hostinger (LiteSpeed; compatible con Apache 2.4)
#   · HTTPS y dominio sin www
#   · URLs limpias → server/index.php (SEO, sitemap, robots, 404)
#   · archivos internos bloqueados
#   · AVIF/WebP automáticos cuando existe la versión optimizada
#   · caché del navegador, compresión y cabeceras de seguridad
# GitHub Pages ignora este archivo: la vista previa estática sigue funcionando.
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex server/index.php index.html
ServerSignature Off
AddDefaultCharset utf-8

<IfModule mod_mime.c>
	AddType font/woff2 .woff2
	AddType image/avif .avif
	AddType image/webp .webp
	AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# HTTPS (Hostinger termina TLS en el propio servidor; X-Forwarded-Proto por si hay proxy delante).
	# No aplica a localhost ni a nombres internos sin punto (p. ej. «sitio» dentro de Docker).
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$
	RewriteCond %{HTTP_HOST} \.
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# www.sunqujourneys.com → sunqujourneys.com
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

	# Archivos internos: nunca se sirven (solo peticiones directas; las internas del enrutador pasan)
	RewriteCond %{ENV:REDIRECT_STATUS} ^$
	RewriteRule ^(\.env.*|\.git.*|server/(?!index\.php$).*|wordpress/.*|docs/.*|tools/.*|.+\.md|.+\.py|.+\.sh|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]

	# Imágenes locales: AVIF o WebP si el navegador los acepta y existe foto.jpg.avif / foto.jpg.webp
	RewriteCond %{HTTP_ACCEPT} image/avif
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteCond %{REQUEST_FILENAME}.avif -f
	RewriteRule ^(assets/.+\.(?:jpe?g|png))$ $1.avif [L]
	RewriteCond %{HTTP_ACCEPT} image/webp
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteCond %{REQUEST_FILENAME}.webp -f
	RewriteRule ^(assets/.+\.(?:jpe?g|png))$ $1.webp [L]

	# Páginas antiguas (.html) → el enrutador responde con 301 a la URL limpia
	RewriteRule ^(index|journey|descubre|recuerda|blog|articulo|terminos|reclamaciones)\.html$ server/index.php [L]
	RewriteRule ^Sunqu(\s|%20)Journeys(\s|%20)v2\.dc\.html$ server/index.php [L]

	# Sitemap, robots y purga de caché
	RewriteRule ^(sitemap\.xml|robots\.txt|_sunqu/purge)$ server/index.php [L]

	# Portada y cualquier URL que no sea un archivo existente
	RewriteRule ^$ server/index.php [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ server/index.php [L]
</IfModule>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
	# HSTS: activo solo sobre HTTPS. Cuando todo el dominio (incluido cms.) funcione con HTTPS, se puede
	# agregar includeSubDomains.
	Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
	Header unset X-Powered-By

	# Imágenes que cambian de formato según el navegador (la misma URL .jpg/.png puede responder AVIF o WebP)
	<FilesMatch "\.(jpe?g|png|avif|webp)$">
		Header append Vary Accept
	</FilesMatch>

	# Caché: CSS/JS llevan ?v= (el enrutador lo agrega) → un año; imágenes, fuentes y video 30 días;
	# contenido JSON (respaldo) 5 minutos.
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.(woff2|ttf)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
		Header set Access-Control-Allow-Origin "*"
	</FilesMatch>
	<FilesMatch "\.(avif|webp|jpe?g|png|svg|ico|mp4)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "\.json$">
		Header set Cache-Control "public, max-age=300"
	</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Nada de listados ni archivos ocultos
<FilesMatch "^\.">
	Require all denied
</FilesMatch>
<FilesMatch "^\.htaccess$">
	Require all denied
</FilesMatch>
