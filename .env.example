# ─────────────────────────────────────────────────────────────────────────────
# Sunqu Journeys · variables de producción
# Copia este archivo como .env FUERA de public_html (en Hostinger: ~/domains/sunqujourneys.com/.env)
# o, si no es posible, en la raíz del sitio (el .htaccess lo bloquea). Nunca subas el .env al repositorio.
# Lo que está vacío queda PENDIENTE DE CONFIGURACIÓN (la web funciona igual, sin esa integración).
# ─────────────────────────────────────────────────────────────────────────────

# production | staging  (staging agrega noindex y robots.txt Disallow)
APP_ENV=production

# Dominio canónico (sin barra final)
SITE_URL=https://sunqujourneys.com

# WordPress headless (plugin «Sunqu CMS»). Vacío = la web usa content/*.json.
# PENDIENTE DE CONFIGURACIÓN: instalar WordPress en cms.sunqujourneys.com (ver docs/DEPLOYMENT.md)
WORDPRESS_API_URL=
# Opcional: URL con la que el servidor lee WordPress si es distinta de la pública (p. ej. dentro de Docker)
WORDPRESS_API_URL_INTERNAL=

# Analítica — PENDIENTE DE CONFIGURACIÓN (crear las cuentas; ver docs/ANALYTICS.md)
# Si hay GTM_ID, GA4 y Meta Pixel se configuran dentro de GTM y no se cargan aparte.
# Alternativa sin tocar el servidor: pegar los códigos en WordPress › Sunqu › Scripts y seguimiento
# (usa una de las dos vías, no ambas: se mediría dos veces).
GA4_ID=
GTM_ID=
META_PIXEL_ID=

# Scripts de WordPress › Sunqu › Scripts y seguimiento (GTM, Analytics, Pixel, Hotjar…): on | off
# off = la web los ignora (interruptor de emergencia si un código rompe la web o no es de confianza)
CMS_SCRIPTS=on

# Respaldo del número de WhatsApp (formato internacional sin +). El que manda es Sunqu › Sitio › WhatsApp.
WHATSAPP_NUMBER=

# Aviso de cookies antes de cargar analítica y publicidad: banner | off
CONSENT_MODE=banner

# Segundos que el servidor guarda el contenido de WordPress antes de volver a pedirlo
CONTENT_CACHE_TTL=300

# Token secreto para que WordPress vacíe la caché al publicar (genera uno largo y aleatorio;
# el mismo valor va en WordPress › Sunqu › Conexión y herramientas › Token de purga)
CACHE_PURGE_TOKEN=

# Content-Security-Policy: enforce (bloquea) | report (solo avisa en la consola del navegador, para probar un servicio nuevo) | off
CSP_MODE=enforce
# Scripts en línea: hash (solo los de la web, por su huella SHA-256) | allow ('unsafe-inline', SOLO si GTM usa
# etiquetas «HTML personalizado»; con plantillas de la galería de GTM no hace falta). Ver docs/SECURITY.md.
CSP_INLINE_SCRIPTS=hash

# Opcional — país aproximado por IP, solo como respaldo para elegir el idioma en la raíz (/) cuando la persona no
# eligió idioma y su navegador no está en uno activo (docs/WORDPRESS.md › 8.7). PENDIENTE DE CONFIGURACIÓN.
# Se consulta desde el servidor (la clave nunca llega al navegador), con caché de 30 días y espera máxima corta.
# {ip} se reemplaza por la IP del visitante. Ejemplos (revisa los términos y el límite gratuito de cada servicio):
#   IPinfo Lite (requiere token gratuito):  GEOIP_URL=https://api.ipinfo.io/lite/{ip}?token=TU_TOKEN   GEOIP_CAMPO=country_code
#   country.is (sin token):                 GEOIP_URL=https://api.country.is/{ip}                      GEOIP_CAMPO=country
# Sin GEOIP_URL se salta este paso (si una CDN manda el país, p. ej. Cloudflare CF-IPCountry, se usa ese).
GEOIP_URL=
GEOIP_CAMPO=country
GEOIP_TIMEOUT_MS=800

# Opcional — verificación anti-bots Cloudflare Turnstile en los formularios. PENDIENTE DE CONFIGURACIÓN.
# Clave pública del sitio (dash.cloudflare.com › Turnstile). La clave secreta NO va aquí: va en el wp-config.php
# del CMS como SUNQU_TURNSTILE_SECRET. Configura las dos o ninguna (con solo la secreta, los formularios fallan).
TURNSTILE_SITE_KEY=
